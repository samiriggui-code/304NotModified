# Copier en .env et remplir. Ne jamais commiter le fichier .env.
ANTHROPIC_API_KEY=
# Connexion au tableau de bord (admin/) : e-mail, empreinte du mot de passe
# (python -m app.cli hash-password) et secret de signature des sessions (texte aléatoire long).
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Facultatif : jeton fixe pour les scripts (en-tête Authorization: Bearer ...)
ADMIN_TOKEN=
NM304_DB=304notmodified.sqlite3
FREE_QUOTA=1000
PRICE_PER_REQUEST_EUR=0.005
LOG_RETENTION_DAYS=365
